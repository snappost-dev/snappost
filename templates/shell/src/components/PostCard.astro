---
interface Props {
  post: {
    slug: string;
    title: string;
    description?: string | null;
    content_html?: string | null;
    created_at: string;
  };
  locale?: string;
}

const { post, locale = 'en-US' } = Astro.props;
const date = new Date(post.created_at).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const descriptionRaw = (post.description ?? '').trim();
const description =
  descriptionRaw.length > 120 ? `${descriptionRaw.slice(0, 117)}...` : descriptionRaw;
const imgMatch = post.content_html?.match(/<img[^>]+src="([^"]+)"/);
const thumbnail = imgMatch?.[1] ?? null;
---

<article class="card bg-base-100 border border-base-300 transition hover:shadow-md">
  {thumbnail && (
    <figure class="aspect-[16/9] overflow-hidden">
      <img src={thumbnail} alt="" class="h-full w-full object-cover" />
    </figure>
  )}
  <a href={`/blog/${post.slug}`} class="card-body block">
    <h2 class="card-title text-2xl mb-2 hover:text-primary">{post.title}</h2>
    {description && <p class="mb-4 text-base-content/80">{description}</p>}
    <time class="text-sm text-base-content/60">{date}</time>
  </a>
</article>
