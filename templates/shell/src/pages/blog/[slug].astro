---
import Base from '../../layouts/Base.astro';
import { loadBlogConfig } from '../../lib/blog-config';
import { shellPostBodyHtml } from '../../lib/post-body';

const { slug } = Astro.params;

const db = Astro.locals.runtime.env.DB;
const post = await db
  .prepare('SELECT * FROM posts WHERE slug = ? AND published = 1')
  .bind(slug)
  .first();

if (!post) {
  return Astro.redirect('/404');
}

const config = await loadBlogConfig(db);

const title = String(post.title ?? '');
const description = post.description != null ? String(post.description) : undefined;
const createdAt = String(post.created_at ?? '');
const updatedAt = post.updated_at != null ? String(post.updated_at) : createdAt;

const date = new Date(createdAt).toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const bodyHtml = shellPostBodyHtml(post as { content_html?: string | null; content?: string | null });

const pageTitle = `${title} – ${config.site_title}`;
const canonicalPath = `/blog/${String(slug ?? '')}`;

const prevPost = await db
  .prepare(
    'SELECT slug, title FROM posts WHERE published = 1 AND created_at < ? ORDER BY created_at DESC LIMIT 1'
  )
  .bind(createdAt)
  .first<{ slug: string; title: string }>();

const nextPost = await db
  .prepare(
    'SELECT slug, title FROM posts WHERE published = 1 AND created_at > ? ORDER BY created_at ASC LIMIT 1'
  )
  .bind(createdAt)
  .first<{ slug: string; title: string }>();
---

<Base
  config={config}
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={new Date(createdAt).toISOString()}
  modifiedTime={new Date(updatedAt).toISOString()}
>
  <article
    class="prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-p:leading-relaxed prose-a:text-primary prose-pre:max-w-full prose-img:max-w-full prose-img:h-auto prose-figure:my-8 prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-base-content/60"
  >
    <h1>{title}</h1>
    <time class="not-prose text-base-content/60 text-sm block mb-6" datetime={createdAt}>{date}</time>
    <div class="post-body" set:html={bodyHtml} />
  </article>

  {(prevPost || nextPost) && (
    <nav class="not-prose mt-8 flex justify-between">
      <div class="join">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="btn btn-outline btn-sm join-item" title={prevPost.title}>
            ← Onceki
          </a>
        ) : (
          <span class="btn btn-outline btn-sm join-item btn-disabled">← Onceki</span>
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="btn btn-outline btn-sm join-item" title={nextPost.title}>
            Sonraki →
          </a>
        ) : (
          <span class="btn btn-outline btn-sm join-item btn-disabled">Sonraki →</span>
        )}
      </div>
    </nav>
  )}
</Base>
