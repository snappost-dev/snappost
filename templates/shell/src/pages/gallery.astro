---
import Base from '../layouts/Base.astro';
import { loadBlogConfig } from '../lib/blog-config';

const config = await loadBlogConfig(Astro.locals.runtime.env.DB);

const postsResult = await Astro.locals.runtime.env.DB
  .prepare(
    'SELECT slug, title, description, content_html, created_at FROM posts WHERE published = 1 ORDER BY created_at DESC'
  )
  .all();

const posts = postsResult.results as {
  slug: string;
  title: string;
  description: string | null;
  content_html: string;
  created_at: string;
}[];

function firstImageSrc(html: string): string | null {
  if (!html) return null;
  const m = html.match(/<img[^>]+src=["']([^"']+)["']/i);
  return m ? m[1].trim() : null;
}
---

<Base title={`Galeri — ${config.site_title}`} description={config.site_description} config={config}>
  <h1 class="text-3xl font-bold mb-2">Galeri</h1>
  <p class="text-gray-600 mb-8">
    Yayınlanmış yazılardan görseller. Yazıda görsel yoksa sadece başlık gösterilir.
  </p>

  {posts.length === 0 ? (
    <p class="text-gray-500">Henüz yayınlanmış yazı yok.</p>
  ) : (
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {posts.map((post) => {
        const img = firstImageSrc(post.content_html);
        return (
          <li>
            <a href={`/blog/${post.slug}`} class="block bg-white rounded-lg border overflow-hidden hover:shadow-md transition">
              {img ? (
                <div class="aspect-video bg-gray-100 overflow-hidden">
                  <img
                    src={img}
                    alt=""
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="aspect-video bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center text-slate-400 text-sm">
                  Görsel yok
                </div>
              )}
              <div class="p-4">
                <h2 class="font-semibold text-lg hover:text-blue-600">{post.title}</h2>
                {post.description && (
                  <p class="text-sm text-gray-600 mt-1 line-clamp-2">{post.description}</p>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</Base>
