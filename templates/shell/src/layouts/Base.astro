---
import SeoHead from '../components/SeoHead.astro';
import { loadTranslations, normalizeLanguage } from '../i18n';
import { loadBlogConfig } from '../lib/blog-config';
import { absoluteUrl, resolveSiteOrigin } from '../lib/site-url';
import { getThemeVars } from '../lib/theme-vars';

interface Props {
  title: string;
  description?: string;
  /** Varsayılan: mevcut istek pathname + search */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Aynı istekte ikinci config sorgusu önlemek için */
  config?: Record<string, string>;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  config: configProp,
} = Astro.props;

const config = configProp ?? (await loadBlogConfig(Astro.locals.runtime.env.DB));

const origin = resolveSiteOrigin(Astro.locals.runtime.env, Astro.url.href, config.custom_domain);
const path = canonicalPath ?? `${Astro.url.pathname}${Astro.url.search}`;
const canonicalHref = absoluteUrl(origin, path);
const rssHref = absoluteUrl(origin, '/rss.xml');
const webSiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.site_title,
  description: config.site_description,
  url: origin,
}).replace(/</g, '\\u003c');

const metaDescRaw = (description ?? config.site_description ?? '').trim();
const metaDesc =
  metaDescRaw.length > 160 ? `${metaDescRaw.slice(0, 157)}…` : metaDescRaw;
const siteLang = normalizeLanguage(config.site_lang || 'en');
const t = loadTranslations(siteLang);
const siteThemeLight = (config.site_theme_light || 'light').trim() || 'light';
const siteThemeDark = (config.site_theme_dark || 'dark').trim() || 'dark';
const lightThemeVars = getThemeVars(siteThemeLight);
const darkThemeVars = getThemeVars(siteThemeDark);
const inlineThemeCss = `[data-theme="${siteThemeLight}"] { ${lightThemeVars} } [data-theme="${siteThemeDark}"] { ${darkThemeVars} }`;
---

<!DOCTYPE html>
<html lang={siteLang} data-theme={siteThemeLight}>
<head>
  <link rel="preconnect" href="https://media.snaplinx.net">
  <link rel="dns-prefetch" href="https://media.snaplinx.net">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content={config.theme_color} />
  <title>{title}</title>
  <SeoHead
    title={title}
    description={metaDesc}
    canonicalHref={canonicalHref}
    siteName={config.site_title}
    ogType={ogType}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    rssHref={rssHref}
  />
  <style set:html={inlineThemeCss}></style>
  <script is:inline>
    const styleLinks = document.querySelectorAll('link[rel="stylesheet"]');
    styleLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;
      link.setAttribute('rel', 'preload');
      link.setAttribute('as', 'style');
      link.setAttribute('onload', "this.onload=null;this.rel='stylesheet'");
      const noscript = document.createElement('noscript');
      noscript.innerHTML = `<link rel="stylesheet" href="${href}">`;
      link.insertAdjacentElement('afterend', noscript);
    });
  </script>
  <script type="application/ld+json" set:html={webSiteJsonLd} />
</head>
<body class="min-h-screen bg-base-200 text-base-content">
  <header class="sticky top-0 z-10 border-b border-base-300 bg-base-100/95 backdrop-blur">
    <div class="navbar max-w-3xl mx-auto px-4">
      <div class="flex-1">
        <a href="/" class="text-xl font-bold">{config.site_title}</a>
      </div>
      <nav class="flex-none">
        <ul class="menu menu-horizontal px-1 gap-2">
          <li><a href="/" class="hover:text-primary">{t.nav_home}</a></li>
          <li><a href="/blog" class="hover:text-primary">{t.nav_blog}</a></li>
          <li><a href="/about" class="hover:text-primary">{t.nav_about}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <slot />
  </main>

  <footer class="border-t border-base-300 bg-base-200 text-center py-8 text-sm text-base-content/60">
    <p>&copy; {new Date().getFullYear()} {config.author_name}</p>
  </footer>

  <button
    id="theme-toggle-btn"
    type="button"
    class="btn btn-outline btn-sm fixed bottom-4 right-4 z-20"
    aria-label="Tema degistir"
  >
    ☀️
  </button>

  <script is:inline define:vars={{ siteThemeLight, siteThemeDark }}>
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const root = document.documentElement;
    const storageKey = 'theme-preference';

    const applyThemePreference = (preference) => {
      const nextTheme = preference === 'dark' ? siteThemeDark : siteThemeLight;
      root.setAttribute('data-theme', nextTheme);
      if (themeToggleBtn) {
        themeToggleBtn.textContent = preference === 'dark' ? '🌙' : '☀️';
      }
    };

    const storedPreference = localStorage.getItem(storageKey);
    const initialPreference = storedPreference === 'dark' ? 'dark' : 'light';
    applyThemePreference(initialPreference);

    themeToggleBtn?.addEventListener('click', () => {
      const currentPreference = localStorage.getItem(storageKey) === 'dark' ? 'dark' : 'light';
      const nextPreference = currentPreference === 'dark' ? 'light' : 'dark';
      localStorage.setItem(storageKey, nextPreference);
      applyThemePreference(nextPreference);
    });
  </script>
</body>
</html>
