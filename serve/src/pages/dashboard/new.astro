---
import Dashboard from "../../layouts/Dashboard.astro";
import { renderEditorJSToHTML } from "../../lib/editor";
import { queryD1 } from "../../lib/d1";
import { isDashboardAuthenticated } from "../../lib/dashboard-auth";

const tenantConfig = Astro.locals.tenant.config;
const d1ApiEnv = Astro.locals.d1ApiEnv;
const authCookie = Astro.cookies.get("auth")?.value;

if (!isDashboardAuthenticated(tenantConfig, authCookie)) {
  return Astro.redirect("/dashboard/login");
}

if (!tenantConfig) {
  return Astro.redirect("/dashboard");
}

let error = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const title = String(formData.get("title") ?? "").trim();
    const slug = String(formData.get("slug") ?? "").trim();
    const description = String(formData.get("description") ?? "").trim();
    const contentRaw = String(formData.get("content") ?? "").trim();
    const published = formData.get("published") === "1" ? 1 : 0;

    if (!title || !slug || !contentRaw) {
      error = "Title, slug, and content are required";
    } else {
      const contentJson = JSON.parse(contentRaw);
      const contentHtml = renderEditorJSToHTML(contentJson);
      const now = new Date().toISOString();

      await queryD1(
        "INSERT INTO posts (slug, title, description, content, content_html, published, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        [slug, title, description, contentRaw, contentHtml, published, now, now],
        tenantConfig.d1_database_id,
        d1ApiEnv
      );

      const inserted = await queryD1<{ id: number }>(
        "SELECT id FROM posts WHERE slug = ? ORDER BY id DESC LIMIT 1",
        [slug],
        tenantConfig.d1_database_id,
        d1ApiEnv
      );
      const id = inserted[0]?.id;
      return Astro.redirect(id ? `/dashboard/edit/${id}` : "/dashboard");
    }
  } catch (e) {
    error = "Error creating post: " + (e as Error).message;
  }
}
---

<Dashboard title="New Post">
  <h1 class="text-3xl font-bold mb-6">New Post</h1>
  {error && <p class="mb-4 text-red-600">{error}</p>}
  <form method="POST" class="space-y-4 max-w-2xl">
    <input class="input input-bordered w-full" name="title" placeholder="Title" required />
    <input class="input input-bordered w-full" name="slug" placeholder="slug" required />
    <input class="input input-bordered w-full" name="description" placeholder="Description" />
    <textarea class="textarea textarea-bordered w-full h-56" name="content" placeholder='{"blocks":[]}' required></textarea>
    <label class="label cursor-pointer justify-start gap-3">
      <input type="checkbox" class="checkbox checkbox-sm" name="published" value="1" />
      <span>Published</span>
    </label>
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
</Dashboard>
