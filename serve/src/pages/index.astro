---
import LandingBase from "../layouts/LandingBase.astro";

if (!Astro.locals.isLanding) {
  return Astro.redirect("/blog");
}

const softwareAppJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Snappost",
  description: "Launch your blog in seconds. No setup, no config files.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  url: "https://snappost.app",
}).replace(/</g, "\\u003c");
---

<LandingBase title="Home">
  <script type="application/ld+json" set:html={softwareAppJsonLd} />
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-6xl font-bold text-gray-900 mb-6">
        Launch Your Blog<br />
        <span class="text-blue-600">In Seconds</span>
      </h1>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        No setup. No config files. No hosting worries.<br />
        Register, name your blog, and you're live.
      </p>
      <a
        href="/register"
        class="inline-block bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition"
      >
        Start Free &rarr;
      </a>
      <p class="text-sm text-gray-500 mt-4">Free forever &bull; No credit card required</p>
    </div>
  </div>
</LandingBase>
